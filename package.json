{
  "name": "dsh-npu",
  "version": "1.0.0",
  "description": "燧心 · Hearthcore — DeepSeek Harness 的本机推理插件：AMD NPU（FLM）与 llama.cpp（Vulkan/ROCm/CUDA）按需加载，第五框架 amd-hybrid 让 NPU+GPU 协同，对外一个 OpenAI 兼容端口与原生 LLM provider；所有推理进程随 DSH 起退，零残留。",
  "type": "module",
  "license": "MIT",
  "author": "YarXVI",
  "homepage": "https://github.com/YarXVI/dsh-npu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YarXVI/dsh-npu.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "npu",
    "amd",
    "xdna",
    "xdna2",
    "fastflowlm",
    "local-llm",
    "hybrid-inference",
    "openai-compatible",
    "llama.cpp",
    "vulkan",
    "rocm",
    "translation",
    "embeddings"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "lib/*.mjs",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/"
  }
}